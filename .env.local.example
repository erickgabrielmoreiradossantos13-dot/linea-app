# Panel de Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key

# Solo necesaria para los endpoints públicos de ingesta (/api/track, /api/lead),
# que escriben visitas/leads reales desde la web publicada de un cliente.
# Marcada como "secreta"/"sensitive" en Vercel. NUNCA con prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key
